#!/bin/bash
# Create a .xyz from smiles, using xtb to form an initial geometry.
# The geometry is written to stdout in xyz format.
#
# Usage:
#   prep smiles-string [charge]

set -e

charge="0"
test x"$1" = x && {
  echo "Usage: prep <smiles>"
  exit 1
}
test "$2" && {
  charge="$2"
}
tmp=prep.$$
mkdir $tmp
(cd $tmp \
  && obabel "-:$1" -h -oxyz -d --gen3d -O prep.xyz > obabel.out 2>&1 \
  && xtb -s prep.xyz --opt --chrg $charge > xtb.out 2>&1 \
  && cat xtbopt.xyz)
# rm -rf $tmp

