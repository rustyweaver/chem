#!/bin/bash

if [[ "$1" == *"nbi-327"* ]]; then
  echo 3
elif [[ "$1" == *"nbi-526"* ]]; then
  echo 1
elif [[ "$1" == *"htota"* ]]; then
  echo 1
elif [[ "$1" == *"daota"* ]]; then
  echo 1
elif [[ "$1" == *"tata"* ]]; then
  echo 1
elif [[ "$1" == *"adota"* ]]; then
  echo 1
elif [[ "$1" == *"aadota"* ]]; then
  echo 1
elif [[ "$1" == *"atota"* ]]; then
  echo 1
elif [[ "$1" == *"tota"* ]]; then
  echo 1
else
  echo "BAD MOLECULE $1" >&2
  exit 1
fi
